{
  "name": "skill-swap-backend",
  "version": "0.1.0",
  "description": "Firebase Cloud Functions backend for the SkillSwap application.",
  "main": "lib/index.js",
  "scripts": {
    "clean": "npx rimraf lib",
    "build": "tsc",
    "build:clean": "npm run clean && npm run build",
    "serve": "npm run build:clean && firebase emulators:start --only functions",
    "deploy": "npm run build:clean && node -e \"process.env.FIREBASE_CONFIG=JSON.stringify({projectId:'skillswap-69yxi'});require('child_process').execSync('firebase deploy --only functions',{stdio:'inherit',env:process.env});\"",
    "lint": "eslint src --ext .ts",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage"
  },
  "dependencies": {
    "@nestjs/common": "^10.3.9",
    "@nestjs/core": "^10.3.9",
    "@nestjs/platform-express": "^10.3.9",
    "@types/busboy": "^1.5.4",
    "algoliasearch": "^4.23.3",
    "axios": "^1.12.2",
    "busboy": "^1.6.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "cors": "^2.8.5",
    "dotenv": "^10.0.0",
    "express": "^4.21.2",
    "express-rate-limit": "^7.4.0",
    "firebase-admin": "^12.7.0",
    "firebase-functions": "^7.0.6",
    "helmet": "^7.1.0",
    "multer": "^2.1.0",
    "nodemailer": "^7.0.12",
    "pg": "^8.16.3",
    "pino": "^9.6.0",
    "pino-http": "^10.4.0",
    "reflect-metadata": "^0.1.13",
    "rxjs": "^7.8.1",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "@nestjs/testing": "^10.3.9",
    "@types/cors": "^2.8.13",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.12",
    "@types/multer": "^2.0.0",
    "@types/node": "^20.4.2",
    "@types/nodemailer": "^7.0.4",
    "@types/pg": "^8.15.5",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "eslint": "^8.57.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.2",
    "typescript": "^5.2.2"
  },
  "type": "commonjs",
  "private": true
}
