rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isValidImageUpload() {
      return request.resource == null
             || (request.resource.size <= 5 * 1024 * 1024
                 && request.resource.contentType.matches('image/.*'));
    }

    function isValidVideoUpload() {
      return request.resource == null
             || (request.resource.size <= 25 * 1024 * 1024
                 && request.resource.contentType.matches('video/.*'));
    }

    // Restrict KYC uploads to the owning user
    match /users/{uid}/kyc/{fileName} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if request.auth != null && request.auth.uid == uid && isValidImageUpload();
    }
    // Public assets; only owners can write
    match /avatars/{uid}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == uid && isValidImageUpload();
    }
    match /covers/{uid}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == uid && isValidImageUpload();
    }
    match /listings/{uid}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == uid && isValidImageUpload();
    }
    match /listing-images/{uid}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == uid && isValidImageUpload();
    }
    match /business-logos/{uid}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.auth.uid == uid
                   && isValidImageUpload();
    }
    match /events/{uid}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == uid && isValidImageUpload();
    }
    match /wishes/{uid}/images/{fileName} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == uid && isValidImageUpload();
    }
    match /wishes/{uid}/videos/{fileName} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == uid && isValidVideoUpload();
    }
    // Dev-only storage checks
    match /dev-check/{fileName} {
      allow read, write: if request.auth != null;
    }
    // Default: deny all access to unmatched paths (secure by default)
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
