rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }
    function userDoc(uid) {
      return get(/databases/$(database)/documents/users/$(uid));
    }
    function isAdmin(uid) {
      return isSignedIn() && userDoc(uid).data.role == 'admin';
    }
    function membership(uid) {
      return userDoc(uid).data.membership;
    }
    function isActiveMember(uid) {
      let m = membership(uid);
      return m != null && m.active == true && m.endDate > request.time;
    }
    function kycVerified(uid) {
      return userDoc(uid).data.kyc.status == 'VERIFIED';
    }
    function listingLimit(m) {
      return m.plan == 'Basic' ? 9 : (m.plan == 'Standard' ? 12 : 9999999);
    }
    function canCreateListing(uid) {
      let m = membership(uid);
      return m != null && m.listingCount < listingLimit(m);
    }
    function isClean(text) {
      return !text.lower().matches('.*(weapon|drugs|adult|gambling).*');
    }
    function isSafeUserUpdate() {
      let changed = request.resource.data.diff(resource.data).changedKeys();
      return !changed.hasAny(['membership', 'kyc', 'role', 'rating', 'ratingSum', 'reviewsCount']);
    }

    /** Public profile docs anyone can read; writes are server-only */
    match /publicProfiles/{uid} {
      allow read: if true;
      allow create, update, delete: if false;
    }

    /** User profiles */
    match /users/{userId} {
      allow get: if isSignedIn() && request.auth.uid == userId;
      allow list: if false;
      allow create: if isSignedIn() && request.auth.uid == userId;
      allow update: if isSignedIn() && request.auth.uid == userId && isSafeUserUpdate();
      allow delete: if false;
    }

    /** Listings — server-only writes; client reads exclude removed items */
    match /listings/{id} {
      allow read: if resource == null || resource.data.get('status', '') != 'removed';
      allow create, update, delete: if false;
    }

    /** Requests — participants can read; server-only writes */
    match /requests/{id} {
      allow read: if isSignedIn() &&
                  (resource.data.requesterId == request.auth.uid || resource.data.ownerId == request.auth.uid);
      allow create, update, delete: if false;
    }

    /** Notifications — users can read their own notifications; writes are server-only */
    match /notifications/{id} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create, update, delete: if false;
    }

    /** KYC verification sub-collection under a user: server writes only; user can read own */
    match /users/{userId}/kyc/{docId} {
      allow read: if isSignedIn() && request.auth.uid == userId;
      allow create, update, delete: if false;
    }

    /** Temporary KYC status for pre-signup flow: authenticated read, server-only writes */
    match /kyc_temp/{vendor} {
      allow read: if isSignedIn();
      allow create, update, delete: if false;
    }

    /** Wishes: public readable; writes go through backend only */
    match /wishes/{wishId} {
      allow read: if true;
      allow create, update, delete: if false;
    }

    /** Events: public readable; writes go through backend only */
    match /events/{eventId} {
      allow read: if true;
      allow create, update, delete: if false;
    }

    /** Event registrations: server-only writes */
    match /eventRegistrations/{id} {
      allow read: if false;
      allow create, update, delete: if false;
    }

    /** Wish donations (current): server-only access */
    match /wishDonations/{donId} {
      allow read: if false;
      allow create, update, delete: if false;
    }

    /** Wish donations (legacy path): server-only access */
    match /wishes/{wishId}/donations/{donId} {
      allow read: if false;
      allow create, update, delete: if false;
    }

    /** Moderation flags — admin read only; server writes */
    match /moderationFlags/{flagId} {
      allow read: if isAdmin(request.auth.uid);
      allow create, update, delete: if false;
    }

    /** Moderation reports — signed-in users can create; admin read only */
    match /moderationReports/{reportId} {
      allow read: if isAdmin(request.auth.uid);
      allow create: if isSignedIn();
      allow update, delete: if false;
    }

    /** Moderation keywords — admin only */
    match /moderationKeywords/{docId} {
      allow read, create, update, delete: if isAdmin(request.auth.uid);
    }

    /** Admin audit logs — admin read only */
    match /adminAudit/{docId} {
      allow read: if isAdmin(request.auth.uid);
      allow create, update, delete: if false;
    }

    /** Notification dead letters — server writes, admin reads */
    match /notificationDeadLetters/{docId} {
      allow read: if isAdmin(request.auth.uid);
      allow create, update, delete: if false;
    }

    /** KYC session references (Didit) — server-only; clients have no direct access */
    match /kycReferences/{docId} {
      allow read, create, update, delete: if false;
    }

    /** Device tokens — server-only access */
    match /deviceTokens/{userId} {
      allow read, create, update, delete: if false;
    }

    /** Reviews — publicly readable; writes are server-only */
    match /reviews/{reviewId} {
      allow read: if true;
      allow create, update, delete: if false;
    }

    /** Match acceptances: allow participants to read progress; writes are server-only */
    match /matchAcceptances/{key} {
      allow read: if isSignedIn() && (
        request.auth.uid in resource.data.users ||
        (resource.data.acceptedBy != null && request.auth.uid in resource.data.acceptedBy)
      );
      allow create, update, delete: if false;
    }
  }
}
