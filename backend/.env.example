# ── App ──────────────────────────────────────────────────────────────────────
# Public URL of the frontend (used as Didit KYC callback base; no trailing slash)
APP_URL=https://backdup-333cf.web.app
# Firebase project ID (set automatically by Cloud Functions; useful for local dev)
GCLOUD_PROJECT=backdup-333cf

# ── Didit KYC ─────────────────────────────────────────────────────────────────
DIDIT_API_KEY=
DIDIT_WORKFLOW_ID=
DIDIT_BASE_URL=https://verification.didit.me
# If set, overrides the APP_URL-based callback URL
DIDIT_CALLBACK_URL=
DIDIT_WEBHOOK_SECRET=

GEIDEA_MERCHANT_ID=
GEIDEA_API_PASSWORD=
GEIDEA_CALLBACK_URL=
GEIDEA_BASE_URL=https://api.geidea.net
GEIDEA_WEBHOOK_SECRET=

ALGOLIA_APP_ID=
ALGOLIA_API_KEY=
ALGOLIA_INDEX=listings

POSTGRES_CONNECTION_STRING=
GOOGLE_MAPS_API_KEY=
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
ALLOWED_ORIGINS=

# Set to 0 in production — 1 only for local emulator testing
USE_MOCK_PAYMENTS=0

# Set to 'true' after enabling Firebase App Check in the Firebase console
# and wiring the App Check SDK in both frontend and mobile.
ENFORCE_APP_CHECK=false
