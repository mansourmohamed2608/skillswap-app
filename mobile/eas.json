{
  "cli": {
    "version": ">= 13.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_USE_EMULATORS": "false",
        "EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET": "skillswap-69yxi.appspot.com",
        "EXPO_PUBLIC_FUNCTIONS_BASE": "https://skillswap-69yxi.web.app"
      }
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "ios": {
        "simulator": false
      },
      "env": {
        "EXPO_PUBLIC_USE_EMULATORS": "false",
        "EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET": "skillswap-69yxi.appspot.com",
        "EXPO_PUBLIC_FUNCTIONS_BASE": "https://skillswap-69yxi.web.app"
      }
    },
    "production": {
      "autoIncrement": true,
      "android": {
        "buildType": "app-bundle"
      },
      "ios": {
        "distribution": "store"
      },
      "env": {
        "EXPO_PUBLIC_USE_EMULATORS": "false",
        "EXPO_PUBLIC_USE_MOCK_PAYMENTS": "false",
        "EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET": "skillswap-69yxi.appspot.com",
        "EXPO_PUBLIC_FUNCTIONS_BASE": "https://skillswap-69yxi.web.app"
      }
    }
  },
  "submit": {
    "production": {
      "android": {
        "track": "internal",
        "releaseStatus": "draft"
      },
      "ios": {
        "appleTeamId": "YOUR_APPLE_TEAM_ID"
      }
    }
  }
}
