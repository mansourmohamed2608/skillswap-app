  "legal": {
    "terms": {
      "title": "الشروط والأحكام",
      "updated": "آخر تحديث: 26 يوليو 2024",
      "intro1": "مرحبًا بك في سكيل سواپ! توضح هذه الشروط والأحكام قواعد استخدام موقع وخدمات سكيل سواپ (\"الخدمة\").",
      "intro2": "بدخولك هذا الموقع نفترض أنك توافق على هذه الشروط والأحكام. لا تواصل استخدام سكيل سواپ إذا كنت لا توافق على جميع الشروط المذكورة في هذه الصفحة.",
      "sections": {
        "definitions": {
          "title": "1. التعريفات",
          "body": "تسري المصطلحات التالية على هذه الشروط والأحكام وبيان الخصوصية وإشعار إخلاء المسؤولية وجميع الاتفاقيات: يشير مصطلح «العميل» و«أنت» و«خاصتك» إلى الشخص الذي يسجل دخوله إلى هذا الموقع ويلتزم بشروط الشركة. وتشير «الشركة» و«نحن» و«لدينا» إلى شركتنا. ويشير «الطرف» أو «الأطراف» إلى العميل ونحن معًا. وتشير جميع المصطلحات إلى عرض وقبول ومقابل الدفع اللازم لإتمام عملية مساعدتنا للعميل بالشكل الأنسب لتلبية احتياجاته فيما يتعلق بتقديم خدمات الشركة، وفقًا للقانون الساري في هولندا. وتُعد أي استخدامات للمصطلحات السابقة بصيغ المفرد أو الجمع أو بحروف كبيرة أو الضمائر المختلفة متبادلة ولها المعنى نفسه."
        },
        "cookies": {
          "title": "2. ملفات تعريف الارتباط",
          "body1": "نستخدم ملفات تعريف الارتباط (الكوكيز). وبوصولك إلى سكيل سواپ، فإنك توافق على استخدام الكوكيز وفقًا لسياسة الخصوصية الخاصة بنا.",
          "body2": "تستخدم معظم المواقع التفاعلية الكوكيز لاسترجاع تفاصيل المستخدم في كل زيارة. وتُستخدم الكوكيز في موقعنا لتمكين وظائف بعض الأقسام وتسهيل التجربة على الزوار. وقد يستخدم بعض شركائنا الإعلانيين ملفات تعريف الارتباط أيضًا."
        },
        "license": {
          "title": "3. الترخيص",
          "body1": "ما لم يُذكر خلاف ذلك، تمتلك سكيل سواپ و/أو مرخصوها حقوق الملكية الفكرية لجميع المواد على سكيل سواپ. جميع حقوق الملكية الفكرية محفوظة. يمكنك الوصول إلى المواد للاستخدام الشخصي مع الالتزام بالقيود الواردة في هذه الشروط والأحكام.",
          "listIntro": "يجب ألا تقوم بما يلي:",
          "list": [
            "إعادة نشر مواد من سكيل سواپ",
            "بيع أو تأجير أو منح ترخيص فرعي لمواد سكيل سواپ",
            "إعادة إنتاج أو نسخ أو تكرار مواد سكيل سواپ",
            "إعادة توزيع محتوى سكيل سواپ"
          ],
          "body2": "يبدأ هذا الاتفاق من تاريخ صدوره."
        },
        "comments": {
          "title": "4. تعليقات المستخدمين",
          "body": "يمكن للمستخدمين نشر محتوى مثل العروض والمراجعات والرسائل. أنت مسؤول عن محتواك ويجب ألا تنشر مواد غير قانونية أو ضارة أو مضللة. وبنشر المحتوى تمنح سكيل سواپ ترخيصًا غير حصري لعرضه وتوزيعه لتشغيل الخدمة."
        },
        "hyperlinking": {
          "title": "5. الروابط إلى المحتوى",
          "body": "يمكنك الربط بصفحاتنا العامة بشرط ألا يكون الرابط مضللًا أو يوحي بتأييد، وأن يلتزم بالقوانين المعمول بها. ويحق لنا طلب إزالة أي رابط."
        },
        "iframes": {
          "title": "6. الإطارات",
          "body": "من دون موافقة مسبقة وخطية، لا يجوز إنشاء إطارات حول صفحات موقعنا تغيّر العرض البصري أو مظهر الموقع بأي شكل."
        },
        "liability": {
          "title": "7. مسؤولية المحتوى",
          "body": "لسنا مسؤولين عن أي محتوى يظهر على موقعك. وتتعهد بحمايتنا والدفاع عنا ضد جميع المطالبات التي تنشأ على موقعك. ولا ينبغي أن يظهر أي رابط على أي موقع يمكن تفسيره بأنه تشهيري أو فاحش أو إجرامي، أو ينتهك حقوق طرف ثالث أو يدعو إلى انتهاكها."
        },
        "rights": {
          "title": "8. حجز الحقوق",
          "body": "نحتفظ بالحق في طلب إزالة جميع الروابط أو أي رابط محدد إلى موقعنا. وتوافق على إزالة جميع الروابط إلى موقعنا فور طلبنا. كما نحتفظ بالحق في تعديل هذه الشروط والأحكام وسياسة الروابط في أي وقت. وباستمرارك في الربط إلى موقعنا، فإنك توافق على الالتزام بهذه الشروط."
        },
        "disclaimer": {
          "title": "9. إخلاء المسؤولية",
          "body1": "إلى الحد الأقصى الذي يسمح به القانون، نستبعد جميع الضمانات والشروط المتعلقة بموقعنا واستخدامه. ولا شيء في هذا الإخلاء سي:",
          "list": [
            "يحد أو يستثني مسؤوليتنا أو مسؤوليتك عن الوفاة أو الإصابة الشخصية؛",
            "يحد أو يستثني مسؤوليتنا أو مسؤوليتك عن الاحتيال أو التصريح الاحتيالي؛",
            "يحد أيًا من مسؤولياتنا أو مسؤولياتك بأي طريقة غير مسموح بها قانونًا؛ أو",
            "يستثني أيًا من مسؤولياتنا أو مسؤولياتك التي لا يجوز استثناؤها قانونًا."
          ],
          "body2": "تخضع القيود والمحظورات الواردة في هذا القسم وفي مواضع أخرى من هذا الإخلاء للفقرة السابقة، وتُنظم جميع المسؤوليات الناشئة بموجب هذا الإخلاء، بما في ذلك المسؤوليات الناشئة عن العقد أو الفعل الضار أو الإخلال بالواجب القانوني.",
          "body3": "طالما أن الموقع والمعلومات والخدمات المقدمة فيه مجانية، فلن نكون مسؤولين عن أي خسارة أو ضرر من أي نوع."
        }
      },
