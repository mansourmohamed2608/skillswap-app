# Firebase web configuration (public client identifiers; do not add server credentials here)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_DATABASE_URL=

# Backend. For Firebase Hosting this is usually https://<project>.web.app/api.
NEXT_PUBLIC_FUNCTIONS_BASE=
NEXT_PUBLIC_API_BASE=
NEXT_PUBLIC_FUNCTIONS_REGION=europe-west3

# Explicit opt-in. Accepted values: true or 1.
NEXT_PUBLIC_USE_EMULATORS=false
