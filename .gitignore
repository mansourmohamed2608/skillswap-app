yarn-error.log*
.expo/

# Env files
.env
.env.*.local
*.pem
*.p12
*.key
*service-account*.json
*credentials*.json

# OS junk
.DS_Store
Thumbs.db

# Editor
.vscode/

# Caches / builds (common)
.next/
dist/
build/
coverage/
tsconfig.tsbuildinfo
